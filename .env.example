# Pública (navegador). Sem /admin. Já tem esse valor como padrão no código.
VITE_TRACKING_API_URL=https://adroute-five.vercel.app

# ── UTMify: envio de vendas (server-side only) ──
# Credencial de API: UTMify > Integrações > Webhooks > Credenciais de API.
# Sem ela o funil não envia vendas (o pixel da UTMify no navegador continua igual).
UTMIFY_API_TOKEN=
# Opcional: nome da plataforma exibido no painel da UTMify (padrão: SuperSim).
UTMIFY_PLATFORM=
# Opcional: endpoint de pedidos (padrão: https://api.utmify.com.br/api-credentials/orders).
UTMIFY_ORDERS_URL=

# Privada (só servidor). Chave do cloak (CloakForge, slug curated-trail).
# Se não estiver definida, a home cai na página branca (fail-safe) — nunca na oferta.
CLOAK_API_KEY=

# ── Meta Pixel / Conversions API (CAPI) — server-side only ──
# ID do pixel (padrão no código: 1497048498925446, mesmo do navegador).
META_PIXEL_ID=
# Token da API de Conversões: Gerenciador de Eventos > Configurações do pixel >
# API de Conversões > Gerar token. Sem ele, os eventos vão só pelo navegador.
META_CAPI_TOKEN=
# Opcional: código de teste do Gerenciador de Eventos (guia "Testar eventos").
META_TEST_EVENT_CODE=

# ── Gateway PIX (server-side only) ──
# DUAS formas:
#
# 1) HUB DE GATEWAYS (Gatehub) — recomendado: a gateway real (Beehive, Velani,
#    Pingu, Pague-X, FreePay) é escolhida no painel do hub e trocada sem deploy.
#    ATENÇÃO: o hub lê HUB_API_KEY, não PIX_GATEWAY_API_KEY.
#      HUB_URL=https://hub-de-gateways.vercel.app   (opcional; este é o padrão)
#      HUB_API_KEY=hub_live_...                     (obrigatória; ativa o adapter `hub`)
#      HUB_WEBHOOK_SECRET=whs_...                   (obrigatória p/ receber webhook)
#      HUB_SLUG=funil1                              (opcional; qual gateway cobra este funil)
#    O webhook é cadastrado no painel do hub (Webhook do cliente) apontando para
#    https://SEU-DOMINIO/api/public/sup-webhook e assinado com x-hub-signature
#    ("sha256=" + HMAC-SHA256 do corpo bruto). Detalhes em docs/hub.md.
#    Com HUB_API_KEY definida e PIX_GATEWAY vazio, o hub já é o gateway ativo.
#    Para voltar a um gateway direto, basta definir PIX_GATEWAY (itens abaixo).
#
# 2) GATEWAY DIRETA — PIX_GATEWAY_API_KEY
# Padrão: Vexigate. Basta informar a chave — a URL já vem no código.
#   PIX_GATEWAY_API_KEY = vxg_live_...   (enviada como `Authorization: Bearer <key>` + `X-API-Key`)
#
# Para trocar de gateway:
#   PIX_GATEWAY = vexigate | velani | beehive | paguex | hub | generic   (opcional)
#
# Gateways conhecidos (URL já preenchida no código):
#   vexigate → https://vexigate.com/api/v1/payments/pix  (sem www, orientação do suporte; mínimo R$ 10,00)
#              status: https://vexigate.com/api/v1/payments/{id}
#   velani   → https://api.velanipagamentos.com.br/api/v1/api-gateway/v1/transactions
#              status: https://api.velanipagamentos.com.br/api/v1/api-gateway/v1/transactions/{id}
#              amount em CENTAVOS; header `x-api-key`; mínimo R$ 5,00 (500) nesta conta.
#              ⚠️ A CRIAÇÃO exige a Secret Key (`sk_live_...`). A Public Key (`pk_live_...`)
#                 é somente leitura e NÃO cria cobranças (retorna 401).
#   beehive  → https://api.conta.paybeehive.com.br/v1/transactions
#              status: https://api.conta.paybeehive.com.br/v1/transactions/{id}
#              amount em CENTAVOS; auth Basic (`SECRET_KEY:x` em base64) — testado
#              contra a API: Bearer responde 401 e Basic autentica.
#              ⚠️ Use a Secret Key (`sk_live_...`); a Public Key (`pk_live_...`) só serve
#                 para o front-end (tokenização/3DS) e não autentica na API.
#              Exige customer.phone (a doc omite, mas a API recusa sem DDD).
#              Resposta: `id` numérico + `pix.qrcode` (texto copia-e-cola; a imagem
#              do QR é gerada pelo cliente). Webhook: { id, type, objectId, url, data }.
#   paguex   → POST https://api.pague-x.com.br/v1/charges; GET /charges/{id}
#              Centavos; Authorization: Bearer sk_live_...; public key não é usada no PIX.
#              customer.document string, reference para conciliação (NÃO idempotência).
#              pix.copiaECola; webhook sale.paid, data.saleId, x-paguex-signature.
#              PIX_GATEWAY_WEBHOOK_SECRET obrigatório para receber o webhook.
#              Sem mínimo documentado (piso local 0; a rota aplica seu próprio piso).
#   generic  → informe PIX_GATEWAY_CREATE_URL (POST JSON; recebe o pedido + aliases
#              amount_cents/amount_reais e webhook_url/callback_url)
#
# Opcionais (valem para qualquer gateway):
#   PIX_GATEWAY_CREATE_URL   = sobrescreve a URL de criação (obrigatória no generic)
#   PIX_GATEWAY_STATUS_URL   = consulta de status; use {id} onde vai o id.
#                              Vazio = tenta <CREATE_URL>/<id> e <CREATE_URL>?id=<id>
#   PIX_GATEWAY_POSTBACK_URL = webhook por transação (vazio = usa o webhook do painel)
#   PIX_GATEWAY_WEBHOOK_SECRET = segredo HMAC do painel p/ validar a assinatura do webhook.
#                              Vexigate (`whsec_...`): X-Vexigate-Signature = HMAC do corpo bruto.
#                              Velani: campo `signature` = HMAC hex de JSON.stringify(payload.data).
#                              Beehive: não documenta assinatura → a validação é só via API.
#                              Com segredo, webhook sem assinatura válida é negado (401).
#                              Sem segredo, a confirmação é só via consulta à API.
#   PIX_GATEWAY_MIN_AMOUNT_CENTS = piso local em centavos (padrão: vexigate 1000 = R$10,00;
#                              velani 500 = R$5,00, mínimo observado da conta; beehive 0 = sem
#                              mínimo documentado). Abaixo disso a cobrança é recusada com 422.
# Aponte o painel do gateway para https://SEU-DOMINIO/api/public/sup-webhook
PIX_GATEWAY=
PIX_GATEWAY_API_KEY=
PIX_GATEWAY_CREATE_URL=
PIX_GATEWAY_STATUS_URL=
PIX_GATEWAY_POSTBACK_URL=
PIX_GATEWAY_WEBHOOK_SECRET=
PIX_GATEWAY_MIN_AMOUNT_CENTS=

# Contexto criptografado no postback Pague-X (sem banco). Opcional: segredo aleatório
# com 32+ caracteres; vazio = usa PIX_GATEWAY_WEBHOOK_SECRET. Manter estável por
# pelo menos 7 dias; não registrar URLs completas com `ctx` em logs/analytics.
PIX_PAYMENT_CONTEXT_SECRET=

# Consultar cobranças antigas depois de mudar o gateway: preservar as credenciais
# em variáveis separadas. Nomes aceitos: BEEHIVE, VEXIGATE, VELANI, PAGUEX, GENERIC.
# Mesmo padrão para CREATE_URL, STATUS_URL, WEBHOOK_SECRET e MIN_AMOUNT_CENTS.
# PIX_GATEWAY_BEEHIVE_API_KEY=
# PIX_GATEWAY_BEEHIVE_WEBHOOK_SECRET=
# PIX_GATEWAY_BEEHIVE_STATUS_URL=

# ── Consulta de CPF do funil (etapa 1) — server-side only ──
# Provedor padrão Amnesia Tecnologia: GET {CPF_BASE_URL}/?token={CPF_API_KEY}&cpf={numeros}
# → 200 { DADOS: { cpf, nome, nome_mae, data_nascimento, sexo } }; erros também vêm
# com HTTP 200 ({ erro: "..." } ou texto puro de token vencido).
# CPF_PROVIDER=zipcardx volta ao provedor antigo (Bearer + /consult/{numeros}).
# O navegador chama /api/public/sup-cpf?cpf=... (proxy); a chave nunca vai ao browser.
CPF_API_KEY=
CPF_PROVIDER=
CPF_BASE_URL=https://api.amnesiatecnologia.lat
# Opcional: limite de consultas por minuto por IP nesta rota (padrão 12).
CPF_LIMITE_POR_MINUTO=

# PIX_WEBHOOK_SECRET / PIX_CENTRAL_WEBHOOK_SECRET: NÃO usar neste projeto (ficam só na API central).
